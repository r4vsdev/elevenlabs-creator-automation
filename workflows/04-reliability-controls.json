      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "const req = $(\"Receive Kill Switch Request\").first().json.body || {};\nconst rows = $input.all().map(function (i) { return i.json || {}; });\nlet rec = null;\nrows.forEach(function (r) {\n  const f = r.fields || r;\n  if (String(f.Key || \"\") === \"KILL_SWITCH\") { rec = r; }\n});\nif (!rec && rows.length && rows[0].id) { rec = rows[0]; }\nconst cur = rec ? ((rec.Enabled === true) || (rec.fields && rec.fields.Enabled === true)) : false;\nlet next = cur;\nif (req.enabled === true || req.enabled === false) { next = req.enabled; } else { next = !cur; }\nconst recId = rec && rec.id ? rec.id : \"\";\nconst patchBody = { records: [{ id: recId, fields: { Enabled: next } }] };\nconst meta = [];\nmeta.push({ k: \"Previous state\", v: cur ? \"HALTED\" : \"RUNNING\" });\nmeta.push({ k: \"New state\", v: next ? \"HALTED\" : \"RUNNING\" });\nmeta.push({ k: \"Stored in\", v: \"Airtable Settings\" });\nmeta.push({ k: \"Record\", v: recId || \"not found\" });\nconst head = next ? \"Kill switch ON - every workflow will refuse to run\" : \"Kill switch OFF - workflows are live again\";\nconst out = { ok: true, action: \"killswitch\", enabled: next, recordId: recId, patchBody: patchBody, headline: head, detail: \"A checkbox a non-technical teammate can flip. Every workflow reads it as its first step and exits before spending money or writing data.\", meta: meta };\nreturn [{ json: out }];"
      }
    },
