        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "const intent = String($(\"AI Agent1\").first().json.output || \"\").toLowerCase();\nconst halt = intent.indexOf(\"kill\") > -1;\nconst rows = $input.all().map(function (i) { return i.json || {}; });\nlet rec = null;\nrows.forEach(function (r) {\n  const f = r.fields || r;\n  if (String(f.Key || \"\") === \"KILL_SWITCH\") { rec = r; }\n});\nif (!rec && rows.length && rows[0].id) { rec = rows[0]; }\nconst recId = rec && rec.id ? rec.id : \"\";\nconst patchBody = { records: [{ id: recId, fields: { Enabled: halt } }] };\nlet text;\nif (halt) {\n  text = \"🔴🔴🔴 KILL SWITCH ON 🔴🔴🔴\\nWorkflows HALTED (flipped from Telegram)\\n\\nEvery creator marketing workflow will now exit at its first step. No scraping, no AI calls, no writes.\\n\\nSend me \\\"resume the creator workflows\\\" to turn it back on.\";\n} else {\n  text = \"🟢🟢🟢 KILL SWITCH OFF 🟢🟢🟢\\nWorkflows RUNNING (flipped from Telegram)\\n\\nCreator marketing workflows are live again.\";\n}\nreturn [{ json: { halt: halt, recordId: recId, patchBody: patchBody, confirmText: text } }];"
      }
